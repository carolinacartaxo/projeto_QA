{
  "name": "projeto-ibge-bdd",
  "version": "1.0.0",
  "description": "Projeto QA Programador - BDD com Cypress e Cucumber no portal do IBGE",
  "main": "index.js",
  "scripts": {
    "cy:open": "env -u ELECTRON_RUN_AS_NODE cypress open",
    "cy:open:electron": "env -u ELECTRON_RUN_AS_NODE cypress open --browser electron",
    "cy:run": "env -u ELECTRON_RUN_AS_NODE cypress run",
    "cy:headed": "env -u ELECTRON_RUN_AS_NODE cypress run --headed --browser electron",
    "test": "env -u ELECTRON_RUN_AS_NODE cypress run"
  },
  "keywords": [
    "cypress",
    "cucumber",
    "gherkin",
    "bdd",
    "qa",
    "ibge"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "cypress": "^15.14.0",
    "cypress-cucumber-preprocessor": "^4.3.1"
  },
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": false,
    "step_definitions": "cypress/e2e/steps"
  }
}
